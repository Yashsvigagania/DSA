      "source": [
        "t=input()\n",
        "p=input()\n",
        "n,m= len(t), len(p)\n",
        "ans=[i for i in range(n-m+1) if t[i:i+m]==p]\n",
        "print(*ans if ans else[\"No Match\"])"
      ]
