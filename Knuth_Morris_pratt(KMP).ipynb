        "t=input()\n",
        "p=input()\n",
        "x=t.count(p)\n",
        "if x==0:\n",
        "  print(\"No Match\")\n",
        "else:\n",
        "  for i in range(len(t)):\n",
        "    if(t.startswith(p,i)):\n",
        "      print(i,end=\" \")"
