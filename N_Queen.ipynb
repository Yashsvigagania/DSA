      "source": [
        "n=int(input())\n",
        "a=[0]*n\n",
        "f=0\n",
        "def safe(c,r):\n",
        "  return all(a[i]!=r and abs(a[i]-r)!= abs(i-c) for i in range(c))\n",
        "def solve(c):\n",
        "  global f\n",
        "  if c==n:\n",
        "    print(*a)\n",
        "    f=1\n",
        "    return\n",
        "  for r in range(n):\n",
        "      if(safe(c,r)):\n",
        "        a[c]=r\n",
        "        solve(c+1)\n",
        "solve(0)\n",
        "if not f: print(\"-1\")"
      ]
    }
  ]
}